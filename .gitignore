# Build output
/stamp
/dist/
/bin/

# Falsification spikes are throwaway by construction — only their written
# results land (docs/spike-results.md). Keeping the tree ignored means a
# spike branch cannot accidentally ship dead-end code.
/spikes/

# Console build output. `console/dist` is a build artifact, but the directory
# itself is tracked through one placeholder file: `//go:embed all:dist` fails to
# compile against a directory that does not exist, and requiring a Node
# toolchain to build the Go server would be the wrong trade for that.
console/node_modules/
console/dist/*
!console/dist/.gitkeep

# Playwright's own output. The suite is a gate, not an artifact: its report and
# its traces are for the run that produced them.
console/test-results/
console/playwright-report/
console/blob-report/
console/.playwright/

# Test and coverage artifacts
*.out
*.test
/coverage/

# Benchmark output. The results document and the report are per-run artifacts
# uploaded by the bench workflow; the thresholds they are read against are the
# tracked file next to them.
/bench/out/
/bench/baseline/
/bench/bench-output.txt

# Local environment
.env
.env.*
!.env.example

# The demo bundle's per-installation state. `deploy/demo/.env` is covered by the
# rule above and is the whole of R42's answer here: the demo's credentials are
# generated by scripts/quickstart.sh into an untracked file, so there is no demo
# credential in the repository that a non-demo deployment could be started with.
# `.run/` holds the cookie jars, the timing artifact and the verification output
# of the last run.
deploy/demo/.run/

# Editor and OS
.DS_Store
*.swp
.idea/
.vscode/
